{
  "name": "ai-copilot",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,app \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "backend": "cd backend && uvicorn main:app --host 127.0.0.1 --port 8000",
    "build:web": "next build",
    "build:backend": "python backend/build.py",
    "dist:win": "npm run build:web && npm run build:backend && electron-builder --win --x64",
    "dist:mac": "npm run build:web && npm run build:backend && electron-builder --mac"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.1",
    "electron-builder": "^25.1.8"
  },
  "description": "Real-time AI copilot overlay",
  "author": "AI Copilot",
  "build": {
    "appId": "com.aicopilot.app",
    "productName": "AI Copilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "copilot-backend*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}